{
  "schema": "roost-theme-1",
  "name": "phosphor",
  "title": "Phosphor",
  "description": "A green terminal: one monospace face, square boxes, lowercase labels, and faint scan lines behind the chat. Dark only. Bundles JetBrains Mono.",
  "version": "1.0.0",
  "author": "Roost",
  "license": "Apache-2.0",
  "variants": {
    "dark": {
      "base": { "canvas": "#06100a", "text": "#d4f2d9", "accent": "#72f58f" },
      "tokens": {
        "rail": "#040b07",
        "surface": "#0a1810",
        "raised": "#0f2216",
        "bubble-user": "#0a1810",
        "person": "#123020",
        "line": "#1d3a26",
        "line-strong": "#2f6a40",
        "header-line": "#1d3a26",
        "muted": "#8fb898",
        "hint": "#76a07f",
        "faint": "#4f7a5a",
        "hover": "rgb(114 245 143 / 0.07)",
        "active": "rgb(114 245 143 / 0.12)",
        "focus": "#9aa6ff",
        "success": "#72f58f",
        "warning": "#f2c75c",
        "danger": "#ff7a6b",
        "toggle-on": "#72f58f",
        "primary-bg": "#72f58f",
        "primary-text": "#06100a",
        "scrollbar-thumb": "rgb(114 245 143 / 0.2)",
        "scrollbar-thumb-hover": "rgb(114 245 143 / 0.35)",
        "shadow-pop": "rgb(0 0 0 / 0.7)",
        "shadow-raise": "rgb(114 245 143 / 0.08)",
        "popup-shadow": "inset 0 0 0 1px var(--r-line-strong), 0 0 24px rgb(114 245 143 / 0.12)",
        "composer-shadow": "inset 0 0 0 1px var(--r-accent), 0 0 28px rgb(114 245 143 / 0.12)",
        "chart-1": "#72f58f",
        "chart-2": "#9aa6ff",
        "chart-3": "#f2c75c",
        "chart-4": "#5fd6d0",
        "chart-5": "#ff7a6b",
        "chart-6": "#76a07f",
        "code-bg": "#040b07",
        "code-text": "#d4f2d9",
        "code-keyword": "#72f58f",
        "code-string": "#f2c75c",
        "code-number": "#5fd6d0",
        "code-comment": "#76a07f",
        "code-function": "#9aa6ff",
        "code-type": "#5fd6d0"
      }
    }
  },
  "tokens": {
    "font-sans": "\"Phosphor JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "font-mono": "\"Phosphor JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "text-chat": "14px",
    "leading-chat": "23px",
    "tracking-tight": "0em",
    "radius-sm": "0px",
    "radius-md": "0px",
    "radius-lg": "0px",
    "radius-xl": "0px",
    "radius-chip": "0px",
    "radius-row": "0px",
    "radius-tile": "0px",
    "radius-card": "0px",
    "radius-node": "0px",
    "radius-dialog": "0px",
    "radius-panel": "0px",
    "radius-pill": "0px",
    "sidebar-opacity": "0.94",
    "panel-opacity": "0.9",
    "chat-opacity": "0",
    "motion-scale": "0.5"
  }
}
