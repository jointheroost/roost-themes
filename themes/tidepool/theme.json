{
  "schema": "roost-theme-1",
  "name": "tidepool",
  "title": "Tidepool",
  "description": "Deep sea-green with slow rings moving behind the chat. Dark only. No CSS: everything here is tokens and the shader.",
  "version": "1.0.0",
  "author": "Roost",
  "license": "Apache-2.0",
  "variants": {
    "dark": {
      "base": { "canvas": "#0d1a21", "text": "#e2edeb", "accent": "#7dd6b6" },
      "tokens": {
        "rail": "#0b151c",
        "surface": "#13242c",
        "raised": "#183039",
        "bubble-user": "#152a33",
        "line": "#1f3640",
        "line-strong": "#2b4a55",
        "header-line": "#1f3640",
        "muted": "#9db3b3",
        "hint": "#7d9798",
        "faint": "#5f7a7c",
        "success": "#7dd6b6",
        "warning": "#e9c873",
        "danger": "#f08a7a",
        "toggle-on": "#5cc3a0",
        "private": "#b8a6f2",
        "private-bg": "#1d1a33",
        "private-line": "#3a3260",
        "chart-1": "#7dd6b6",
        "chart-2": "#6fb6e8",
        "chart-3": "#e9c873",
        "chart-4": "#b8a6f2",
        "chart-5": "#f08a7a",
        "chart-6": "#7d9798",
        "code-bg": "#0a141a",
        "shadow-raise": "rgb(2 10 14 / 0.45)",
        "composer-shadow": "inset 0 0 0 1px var(--r-line-strong), 0 10px 40px var(--r-shadow-raise)"
      }
    }
  },
  "tokens": {
    "font-sans": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "radius-card": "10px",
    "radius-panel": "16px",
    "radius-chip": "6px",
    "sidebar-opacity": "0.96",
    "panel-opacity": "0.82",
    "chat-opacity": "0"
  }
}
